&НаКлиенте
Функция Акк_ДобавитьШтамп(СведенияОРедактировании) // + <РАУ>_74775_ЛатыповРР 22.09.2026 
	
	ДвоичныеДанныеФайла = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
	СведенияОРедактировании,
	"ДвоичныеДанные");
	
	ДвоичныеДанныеШаблона = Акк_ДвоичныеДанныеШаблонШтамп();
	
	Подразделение 	= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОРедактировании, "Подразделение","");
	Инициатор     		= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОРедактировании, "Инициатор","");
	ОтступСлеваМм = 20;
	ОтступСнизуМм = 40;
	
	Результат = Акк_ВставитьШтампВФайл(
					ДвоичныеДанныеШаблона,
					ДвоичныеДанныеФайла,
					Подразделение,
					Инициатор,
					ОтступСлеваМм,
					ОтступСнизуМм);
	
	Возврат Результат;
	
КонецФункции

