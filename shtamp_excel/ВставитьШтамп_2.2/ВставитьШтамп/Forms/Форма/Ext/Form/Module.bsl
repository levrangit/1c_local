&НаКлиенте
Процедура Акк_ЗаменитьТекстВShape(
	Shape,
	СтарыйТекст,
	НовыйТекст)

	ТипГруппы = 6;

	Если Shape.Type = ТипГруппы Тогда

		Для Номер = 1 По Shape.GroupItems.Count Цикл

			ЭлементГруппы =
				Shape.GroupItems.Item(Номер);

			Акк_ЗаменитьТекстВShape(
				ЭлементГруппы,
				СтарыйТекст,
				НовыйТекст
			);

		КонецЦикла;

		Возврат;

	КонецЕсли;

	Попытка

		Если Shape.TextFrame.HasText <> 0 Тогда

			Текст =
				Shape.TextFrame.TextRange.Text;

			Если СтрНайти(
				Текст,
				СтарыйТекст
			) > 0 Тогда

				Shape.TextFrame.TextRange.Text =
					СтрЗаменить(
						Текст,
						СтарыйТекст,
						НовыйТекст
					);

			КонецЕсли;

		КонецЕсли;

	Исключение

		// Shape может не содержать текстовый объект.
		Возврат;

	КонецПопытки;

КонецПроцедуры


&НаКлиенте
Процедура Акк_ЗаменитьТекстВШтампе(
	ДокументШаблон,
	СтарыйТекст,
	НовыйТекст)

	Для Номер = 1 По ДокументШаблон.Shapes.Count Цикл

		Shape =
			ДокументШаблон.Shapes.Item(Номер);

		Акк_ЗаменитьТекстВShape(
			Shape,
			СтарыйТекст,
			НовыйТекст
		);

	КонецЦикла;

КонецПроцедуры


&НаКлиенте
Функция Акк_НайтиПозициюЯкоряШтампа(
	Документ,
	НомерСтраницы,
	КоличествоСтраниц)

	ТипПозицииОтносительноАбзаца = 0;
	ПризнакВТаблице = 12;

	Попытка

		НачалоСтраницы =
			Документ.GoTo(
				1,
				1,
				НомерСтраницы
			);

		НачалоСтраницы.Collapse(
				ТипПозицииОтносительноАбзаца
		);

		НачальнаяПозиция = НачалоСтраницы.Start;

		Если НомерСтраницы < КоличествоСтраниц Тогда

			КонецСтраницы =
				Документ.GoTo(
					1,
					1,
					НомерСтраницы + 1
				);

			КонецСтраницы.Collapse(
				ТипПозицииОтносительноАбзаца
			);

			КонечнаяПозиция = КонецСтраницы.Start;

		Иначе

			КонечнаяПозиция =
				Документ.Content.End;

		КонецЕсли;

		// Не перебираем все абзацы страницы: от начала страницы пропускаем таблицы целиком.
		ТекущаяПозиция = НачальнаяПозиция;

		Пока ТекущаяПозиция < КонечнаяПозиция Цикл

			ДиапазонЯкоря =
				Документ.Range(
					ТекущаяПозиция,
					ТекущаяПозиция
				);

			Если ДиапазонЯкоря.Information(
				ПризнакВТаблице
			) = 0 Тогда

				Возврат ДиапазонЯкоря;

			КонецЕсли;

			Попытка

				Таблица =
					ДиапазонЯкоря.Tables.Item(1);

				СледующаяПозиция =
					Таблица.Range.End;

				Если СледующаяПозиция <= ТекущаяПозиция Тогда
					СледующаяПозиция = ТекущаяПозиция + 1;
				КонецЕсли;

				ТекущаяПозиция = СледующаяПозиция;

			Исключение

				ТекущаяПозиция = ТекущаяПозиция + 1;

			КонецПопытки;

		КонецЦикла;

	Исключение

		Возврат Неопределено;

	КонецПопытки;

	Возврат Неопределено;

КонецФункции


// Сохраняет штамп с уже подставленным текстом в PNG.
// Поворот сбрасывается перед экспортом и возвращается отдельно —
// иначе PNG с «запечённым» углом сжимается при вставке в Width/Height Shape.
// Сначала пробует PowerPoint.Export, иначе — Word SaveAs HTML.
&НаКлиенте
Функция Акк_СохранитьШтампКакКартинку(Word, Штамп)

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ПутьКартинки", "");
	Результат.Вставить("Ширина", 0);
	Результат.Вставить("Высота", 0);
	Результат.Вставить("УголПоворота", 0);
	Результат.Вставить("ТекстОшибки", "");

	ПутьКартинки = "";
	ПутьHTML = "";
	КаталогКартинокHTML = "";
	PowerPoint = Неопределено;
	Презентация = Неопределено;
	ДокументВременный = Неопределено;
	ИсходныйУголПоворота = 0;

	Попытка

		ИсходныйУголПоворота = Штамп.Rotation;
		Результат.УголПоворота = ИсходныйУголПоворота;

		// Экспортируем без поворота, чтобы сохранить пропорции картинки.
		Если ИсходныйУголПоворота <> 0 Тогда
			Штамп.Rotation = 0;
		КонецЕсли;

		Результат.Ширина = Штамп.Width;
		Результат.Высота = Штамп.Height;

		Штамп.Select();
		Word.Selection.Copy();

		Если ИсходныйУголПоворота <> 0 Тогда
			Штамп.Rotation = ИсходныйУголПоворота;
		КонецЕсли;

	Исключение

		Попытка
			Если ИсходныйУголПоворота <> 0 Тогда
				Штамп.Rotation = ИсходныйУголПоворота;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Результат.ТекстОшибки =
			НСтр("en = 'Failed to copy the filled stamp: '; ru = 'Не удалось скопировать заполненный штамп: '; tr = 'Doldurulmuş damga kopyalanamadı: '")
			+ ОписаниеОшибки();

		Возврат Результат;

	КонецПопытки;

	ПутьКартинки =
		ПолучитьИмяВременногоФайла("png");

	// ---------------------------------------------------------
	// Вариант 1: экспорт через PowerPoint (чистый PNG фигуры).
	// ---------------------------------------------------------

	Попытка

		PowerPoint =
			Новый COMОбъект( // BSLLS:UsingObjectNotAvailableUnix-off
				"PowerPoint.Application"
			);

		Презентация =
			PowerPoint.Presentations.Add(0);

		Слайд =
			Презентация.Slides.Add(1, 12);

		Слайд.Shapes.Paste();

		ФигураНаСлайде =
			Слайд.Shapes.Item(
				Слайд.Shapes.Count
			);

		// ppShapeFormatPNG = 2
		ФигураНаСлайде.Export(ПутьКартинки, 2);

		Презентация.Close();
		Презентация = Неопределено;

		PowerPoint.Quit();
		PowerPoint = Неопределено;

		ФайлКартинки = Новый Файл(ПутьКартинки);

		Если ФайлКартинки.Существует() Тогда

			Результат.Успешно = Истина;
			Результат.ПутьКартинки = ПутьКартинки;

			Возврат Результат;

		КонецЕсли;

	Исключение

		Если Презентация <> Неопределено Тогда
			Попытка
				Презентация.Close();
			Исключение
			КонецПопытки;
			Презентация = Неопределено;
		КонецЕсли;

		Если PowerPoint <> Неопределено Тогда
			Попытка
				PowerPoint.Quit();
			Исключение
			КонецПопытки;
			PowerPoint = Неопределено;
		КонецЕсли;

	КонецПопытки;

	// ---------------------------------------------------------
	// Вариант 2: временный Word-документ → Filtered HTML.
	// ---------------------------------------------------------

	Попытка

		ДокументВременный =
			Word.Documents.Add();

		ДокументВременный.Content.Paste();

		ПутьHTML =
			ПолучитьИмяВременногоФайла("htm");

		// wdFormatFilteredHTML = 10
		ДокументВременный.SaveAs(ПутьHTML, 10);
		ДокументВременный.Close(Ложь);
		ДокументВременный = Неопределено;

		КаталогКартинокHTML =
			Лев(ПутьHTML, СтрДлина(ПутьHTML) - 4)
			+ ".files";

		НайденныйФайлКартинки =
			Акк_НайтиФайлКартинкиВКаталоге(
				КаталогКартинокHTML
			);

		Если ПустаяСтрока(НайденныйФайлКартинки) Тогда

			Результат.ТекстОшибки =
				НСтр("en = 'Failed to export the filled stamp to an image file.'; ru = 'Не удалось сохранить заполненный штамп в файл картинки.'; tr = 'Doldurulmuş damga resim dosyasına kaydedilemedi.'");

			Акк_УдалитьФайлЕслиСуществует(ПутьКартинки);
			Акк_УдалитьФайлЕслиСуществует(ПутьHTML);
			Акк_УдалитьКаталогЕслиСуществует(КаталогКартинокHTML);

			Возврат Результат;

		КонецЕсли;

		КопироватьФайл(
			НайденныйФайлКартинки,
			ПутьКартинки
		);

		Акк_УдалитьФайлЕслиСуществует(ПутьHTML);
		Акк_УдалитьКаталогЕслиСуществует(КаталогКартинокHTML);

		Результат.Успешно = Истина;
		Результат.ПутьКартинки = ПутьКартинки;

		Возврат Результат;

	Исключение

		Если ДокументВременный <> Неопределено Тогда
			Попытка
				ДокументВременный.Close(Ложь);
			Исключение
			КонецПопытки;
		КонецЕсли;

		Акк_УдалитьФайлЕслиСуществует(ПутьКартинки);
		Акк_УдалитьФайлЕслиСуществует(ПутьHTML);
		Акк_УдалитьКаталогЕслиСуществует(КаталогКартинокHTML);

		Результат.ТекстОшибки =
			НСтр("en = 'Error exporting the filled stamp to an image: '; ru = 'Ошибка при сохранении заполненного штампа в картинку: '; tr = 'Doldurulmuş damga resme kaydedilirken hata oluştu: '")
			+ ОписаниеОшибки();

		Возврат Результат;

	КонецПопытки;

КонецФункции


&НаКлиенте
Функция Акк_НайтиФайлКартинкиВКаталоге(КаталогКартинок)

	Если ПустаяСтрока(КаталогКартинок) Тогда
		Возврат "";
	КонецЕсли;

	Каталог = Новый Файл(КаталогКартинок);

	Если Не Каталог.Существует() Тогда
		Возврат "";
	КонецЕсли;

	Маски = Новый Массив;
	Маски.Добавить("*.png");
	Маски.Добавить("*.emf");
	Маски.Добавить("*.wmf");
	Маски.Добавить("*.jpg");
	Маски.Добавить("*.jpeg");
	Маски.Добавить("*.gif");

	ЛучшийФайл = "";
	ЛучшийРазмер = -1;

	Для Каждого Маска Из Маски Цикл

		НайденныеФайлы =
			НайтиФайлы(КаталогКартинок, Маска, Ложь);

		Для Каждого НайденныйФайл Из НайденныеФайлы Цикл

			Если НайденныйФайл.Размер() > ЛучшийРазмер Тогда

				ЛучшийРазмер = НайденныйФайл.Размер();
				ЛучшийФайл = НайденныйФайл.ПолноеИмя;

			КонецЕсли;

		КонецЦикла;

		Если Не ПустаяСтрока(ЛучшийФайл) Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат ЛучшийФайл;

КонецФункции


&НаКлиенте
Процедура Акк_УдалитьФайлЕслиСуществует(ПутьФайла)

	Если ПустаяСтрока(ПутьФайла) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		УдалитьФайлы(ПутьФайла);
	Исключение
	КонецПопытки;

КонецПроцедуры


&НаКлиенте
Процедура Акк_УдалитьКаталогЕслиСуществует(ПутьКаталога)

	Если ПустаяСтрока(ПутьКаталога) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		УдалитьФайлы(ПутьКаталога);
	Исключение
	КонецПопытки;

КонецПроцедуры


&НаКлиенте
Функция Акк_РассчитатьПозициюШтампаСПоворотом(
	ОтступСлева,
	ОтступСнизу,
	ВысотаСтраницы,
	ШиринаШтампа,
	ВысотаШтампа,
	УголПоворота)

	Результат = Новый Структура;
	Результат.Вставить("Left", ОтступСлева);
	Результат.Вставить(
		"Top",
		ВысотаСтраницы - ОтступСнизу - ВысотаШтампа
	);

	Если УголПоворота = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Word вращает фигуру вокруг центра; визуальная AABB больше Width/Height.
	УголРад =
		УголПоворота
		* 3.14159265358979
		/ 180;

	ЗначениеCos = Cos(УголРад);
	ЗначениеSin = Sin(УголРад);

	CosУг = Макс(ЗначениеCos, -ЗначениеCos);
	SinУг = Макс(ЗначениеSin, -ЗначениеSin);

	ШиринаОхвата =
		ШиринаШтампа * CosУг
		+ ВысотаШтампа * SinУг;

	ВысотаОхвата =
		ШиринаШтампа * SinУг
		+ ВысотаШтампа * CosУг;

	// Левый и нижний края визуальной рамки = заданные отступы.
	Результат.Left =
		ОтступСлева
		+ (ШиринаОхвата - ШиринаШтампа) / 2;

	Результат.Top =
		ВысотаСтраницы
		- ОтступСнизу
		- (ВысотаОхвата + ВысотаШтампа) / 2;

	Возврат Результат;

КонецФункции


&НаКлиенте
Функция Акк_ВставитьШтампНаКаждуюСтраницу(
	Документ,
	ПутьКартинкиШтампа,
	ШиринаШтампа,
	ВысотаШтампа,
	УголПоворота,
	ОтступСлеваМм,
	ОтступСнизуМм)

	Результат = Акк_СоздатьРезультатВставки();

	ТипПозицииОтносительноСтраницы = 1;
	ТипОбтеканияПередОбъектом = 3;
	ПризнакВТаблице = 12;

	КоличествоСтраниц = 0;
	ОтступСлева = 0;
	ОтступСнизу = 0;

	КэшВысотыСтраницПоРазделам = Новый Соответствие;

	Попытка

		КоличествоСтраниц =
			Документ.ComputeStatistics(2);

		ОтступСлева =
			Акк_МмВПункты(ОтступСлеваМм);

		ОтступСнизу =
			Акк_МмВПункты(ОтступСнизуМм);

	Исключение

		Результат.ТекстОшибки =
			НСтр("en = 'Failed to determine page parameters: '; ru = 'Не удалось определить параметры страниц: '; tr = 'Sayfa parametreleri belirlenemedi: '")
			+ ОписаниеОшибки();

		Возврат Результат;

	КонецПопытки;

	Для НомерСтраницы = 1 По КоличествоСтраниц Цикл

		Попытка

			ДиапазонЯкоря =
				Акк_НайтиПозициюЯкоряШтампа(
					Документ,
					НомерСтраницы,
					КоличествоСтраниц
				);

			Если ДиапазонЯкоря = Неопределено Тогда

				Результат.ТекстОшибки =
					НСтр("en = 'On page '; ru = 'На странице '; tr = 'Sayfa '")
					+ НомерСтраницы
					+ НСтр("en = ' no paragraph outside a table was found for the stamp anchor.'; ru = ' не найден абзац вне таблицы для якоря штампа.'; tr = ' damga bağlantı noktası için tablo dışında paragraf bulunamadı.'");

				Возврат Результат;

			КонецЕсли;

			Если ДиапазонЯкоря.Information(
				ПризнакВТаблице
			) <> 0 Тогда

				Результат.ТекстОшибки =
					НСтр("en = 'The stamp anchor on page '; ru = 'Якорь штампа на странице '; tr = 'Sayfa '")
					+ НомерСтраницы
					+ НСтр("en = ' is inside a table.'; ru = ' находится внутри таблицы.'; tr = ' damga bağlantı noktası tablonun içinde.'");

				Возврат Результат;

			КонецЕсли;

		Исключение

			Результат.ТекстОшибки =
				НСтр("en = 'Failed to determine the anchor for page '; ru = 'Не удалось определить якорь для страницы '; tr = 'Sayfa damga bağlantı noktası belirlenemedi: '")
				+ НомерСтраницы
				+ ": "
				+ ОписаниеОшибки();

			Возврат Результат;

		КонецПопытки;

		Попытка

			НомерРаздела =
				ДиапазонЯкоря.Information(2);

			ВысотаСтраницы =
				КэшВысотыСтраницПоРазделам.Получить(
					НомерРаздела
				);

			Если ВысотаСтраницы = Неопределено Тогда

				ВысотаСтраницы =
					Документ.Sections.Item(
						НомерРаздела
					).PageSetup.PageHeight;

				КэшВысотыСтраницПоРазделам.Вставить(
					НомерРаздела,
					ВысотаСтраницы
				);

			КонецЕсли;

			КоличествоShapesДо =
				Документ.Shapes.Count;

			// Якорь задаётся текущим выделением.
			ДиапазонЯкоря.Select();

			ВставленныйШтамп =
				Документ.Shapes.AddPicture(
					ПутьКартинкиШтампа,
					Ложь,
					Истина
				);

			Если Документ.Shapes.Count
				<= КоличествоShapesДо Тогда

				Результат.ТекстОшибки =
					НСтр("en = 'Failed to insert the stamp on page '; ru = 'Не удалось вставить штамп на страницу '; tr = 'Damga sayfaya eklenemedi: '")
					+ НомерСтраницы
					+ ".";

				Возврат Результат;

			КонецЕсли;

			ВставленныйШтамп.Name =
				Акк_ИмяШтампа();

			// Пропорции берём из PNG, не из Shape.Width/Height —
			// у экспортированной картинки соотношение сторон может отличаться.
			// msoTrue = -1
			ВставленныйШтамп.LockAspectRatio = -1;
			ВставленныйШтамп.Width = ШиринаШтампа;

			ФактическаяШирина = ВставленныйШтамп.Width;
			ФактическаяВысота = ВставленныйШтамп.Height;

			Если УголПоворота <> 0 Тогда
				ВставленныйШтамп.Rotation = УголПоворота;
			КонецЕсли;

			Позиция =
				Акк_РассчитатьПозициюШтампаСПоворотом(
					ОтступСлева,
					ОтступСнизу,
					ВысотаСтраницы,
					ФактическаяШирина,
					ФактическаяВысота,
					УголПоворота
				);

			ВставленныйШтамп.RelativeHorizontalPosition =
				ТипПозицииОтносительноСтраницы;

			ВставленныйШтамп.RelativeVerticalPosition =
				ТипПозицииОтносительноСтраницы;

			ВставленныйШтамп.Left = Позиция.Left;
			ВставленныйШтамп.Top = Позиция.Top;

			ВставленныйШтамп.WrapFormat.Type =
				ТипОбтеканияПередОбъектом;

			ВставленныйШтамп.LayoutInCell = Ложь;
			ВставленныйШтамп.LockAnchor = Истина;
			ВставленныйШтамп.ZOrder(0);

		Исключение

			Результат.ТекстОшибки =
				НСтр("en = 'Error inserting the stamp image on page '; ru = 'Ошибка при вставке картинки штампа на страницу '; tr = 'Damga resmi sayfaya eklenirken hata oluştu: '")
				+ НомерСтраницы
				+ ": "
				+ ОписаниеОшибки();

			Возврат Результат;

		КонецПопытки;

	КонецЦикла;

	Результат.Успешно = Истина;

	Возврат Результат;

КонецФункции


&НаКлиенте
Функция Акк_ЗакрытьWord(
	Word,
	Документ,
	ДокументШаблон,
	Результат)

	Если ДокументШаблон <> Неопределено Тогда

		Попытка
			ДокументШаблон.Close(Ложь);
		Исключение
			Результат.ТекстОшибки =
				НСтр("en = 'Failed to close the template: '; ru = 'Не удалось закрыть шаблон: '; tr = 'Şablon kapatılamadı: '")
				+ ОписаниеОшибки();

			Возврат Результат;
		КонецПопытки;

	КонецЕсли;

	Если Документ <> Неопределено Тогда

		Попытка
			Документ.Close(Ложь);
		Исключение
			Результат.ТекстОшибки =
				НСтр("en = 'Failed to close the document: '; ru = 'Не удалось закрыть документ: '; tr = 'Belge kapatılamadı: '")
				+ ОписаниеОшибки();

			Возврат Результат;
		КонецПопытки;

	КонецЕсли;

	Если Word <> Неопределено Тогда

		Попытка
			Word.ScreenUpdating = Истина;
		Исключение
			// Не критично при завершении Word.
		КонецПопытки;

		Попытка
			Word.Quit();
		Исключение
			Результат.ТекстОшибки =
				НСтр("en = 'Failed to terminate Word: '; ru = 'Не удалось завершить Word: '; tr = 'Word sonlandırılamadı: '")
				+ ОписаниеОшибки();

			Возврат Результат;
		КонецПопытки;

	КонецЕсли;

	Возврат Результат;

КонецФункции


&НаКлиенте
Функция Акк_УдалитьВременныеФайлы(
	ПутьШаблона,
	ПутьФайла,
	ПутьРезультата,
	ПутьКартинки,
	Результат)

	Если ПутьШаблона <> "" Тогда

		Попытка
			УдалитьФайлы(ПутьШаблона);
		Исключение
			Результат.ТекстОшибки =
				НСтр("en = 'Failed to delete the temporary template file: '; ru = 'Не удалось удалить временный файл шаблона: '; tr = 'Geçici şablon dosyası silinemedi: '")
				+ ОписаниеОшибки();

			Возврат Результат;
		КонецПопытки;

	КонецЕсли;

	Если ПутьФайла <> "" Тогда

		Попытка
			УдалитьФайлы(ПутьФайла);
		Исключение
			Результат.ТекстОшибки =
				НСтр("en = 'Failed to delete the temporary document file: '; ru = 'Не удалось удалить временный файл документа: '; tr = 'Geçici belge dosyası silinemedi: '")
				+ ОписаниеОшибки();

			Возврат Результат;
		КонецПопытки;

	КонецЕсли;

	Если ПутьРезультата <> "" Тогда

		Попытка
			УдалитьФайлы(ПутьРезультата);
		Исключение
			Результат.ТекстОшибки =
				НСтр("en = 'Failed to delete the temporary result file: '; ru = 'Не удалось удалить временный файл результата: '; tr = 'Geçici sonuç dosyası silinemedi: '")
				+ ОписаниеОшибки();

			Возврат Результат;
		КонецПопытки;

	КонецЕсли;

	Если ПутьКартинки <> "" Тогда

		Попытка
			УдалитьФайлы(ПутьКартинки);
		Исключение
			Результат.ТекстОшибки =
				НСтр("en = 'Failed to delete the temporary stamp image file: '; ru = 'Не удалось удалить временный файл картинки штампа: '; tr = 'Geçici damga resmi dosyası silinemedi: '")
				+ ОписаниеОшибки();

			Возврат Результат;
		КонецПопытки;

	КонецЕсли;

	Возврат Результат;

КонецФункции


// Временные файлы удаляются централизованной процедурой на всех выходах функции.
// BSLLS:MissingTemporaryFileDeletion-off
&НаКлиенте
Функция Акк_ВставитьШтампВФайл(
	ДвоичныеДанныеШаблона,
	ДвоичныеДанныеФайла,
	Подразделение,
	ФИО_Инициатор,
	ОтступСлеваМм,
	ОтступСнизуМм)

	Результат = Акк_СоздатьРезультат();

	ПутьШаблона = "";
	ПутьФайла = "";
	ПутьРезультата = "";
	ПутьКартинки = "";

	Word = Неопределено;
	Документ = Неопределено;
	ДокументШаблон = Неопределено;

	// ---------------------------------------------------------
	// Создание временных файлов.
	// ---------------------------------------------------------

	Попытка

		РасширениеDOCX = "docx";

		ПутьШаблона =
			ПолучитьИмяВременногоФайла(
				РасширениеDOCX
			);

		ПутьФайла =
			ПолучитьИмяВременногоФайла(
				РасширениеDOCX
			);

		ПутьРезультата =
			ПолучитьИмяВременногоФайла(
				РасширениеDOCX
			);

		ДвоичныеДанныеШаблона.Записать(
			ПутьШаблона
		);

		ДвоичныеДанныеФайла.Записать(
			ПутьФайла
		);

	Исключение

		Результат.ТекстОшибки =
			НСтр("en = 'Error creating temporary files: '; ru = 'Ошибка при создании временных файлов: '; tr = 'Geçici dosyalar oluşturulurken hata oluştu: '")
			+ ОписаниеОшибки();

		Если ПутьШаблона <> "" Тогда
			Попытка
				УдалитьФайлы(ПутьШаблона);
			Исключение
				Результат.ТекстОшибки =
					НСтр("en = 'Failed to delete the temporary template file: '; ru = 'Не удалось удалить временный файл шаблона: '; tr = 'Geçici şablon dosyası silinemedi: '")
					+ ОписаниеОшибки();

				Возврат Результат;
			КонецПопытки;
		КонецЕсли;

		Если ПутьФайла <> "" Тогда
			Попытка
				УдалитьФайлы(ПутьФайла);
			Исключение
				Результат.ТекстОшибки =
					НСтр("en = 'Failed to delete the temporary document file: '; ru = 'Не удалось удалить временный файл документа: '; tr = 'Geçici belge dosyası silinemedi: '")
					+ ОписаниеОшибки();

				Возврат Результат;
			КонецПопытки;
		КонецЕсли;

		Если ПутьРезультата <> "" Тогда
			Попытка
				УдалитьФайлы(ПутьРезультата);
			Исключение
				Результат.ТекстОшибки =
					НСтр("en = 'Failed to delete the temporary result file: '; ru = 'Не удалось удалить временный файл результата: '; tr = 'Geçici sonuç dosyası silinemedi: '")
					+ ОписаниеОшибки();

				Возврат Результат;
			КонецПопытки;
		КонецЕсли;

		Возврат Результат;

	КонецПопытки;

	// ---------------------------------------------------------
	// Запуск Word и открытие целевого документа.
	// ---------------------------------------------------------

	Попытка

		Word =
			Новый COMОбъект( // BSLLS:UsingObjectNotAvailableUnix-off
				"Word.Application"
			);

		Word.Visible = Ложь;
		Word.DisplayAlerts = 0;
		Word.ScreenUpdating = Ложь;

		Документ =
			Word.Documents.Open(
				ПутьФайла,
				Ложь,
				Ложь
			);

	Исключение

		Результат.ТекстОшибки =
			НСтр("en = 'Error opening the target document: '; ru = 'Ошибка при открытии целевого документа: '; tr = 'Hedef belge açılırken hata oluştu: '")
			+ ОписаниеОшибки();

		Результат = Акк_ЗакрытьWord(
			Word,
			Документ,
			ДокументШаблон,
			Результат
		);

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецПопытки;

	// ---------------------------------------------------------
	// Проверка существующего штампа.
	// ---------------------------------------------------------

	Попытка

		СуществующийШтамп =
			Акк_НайтиШтампВДокументе(
				Документ
			);

	Исключение

		Результат.ТекстОшибки =
			НСтр("en = 'Error checking for an existing stamp: '; ru = 'Ошибка при проверке наличия штампа: '; tr = 'Mevcut damga kontrol edilirken hata oluştu: '")
			+ ОписаниеОшибки();

		Результат = Акк_ЗакрытьWord(
			Word,
			Документ,
			ДокументШаблон,
			Результат
		);

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецПопытки;

	Если СуществующийШтамп <> Неопределено Тогда

		Результат.ШтампЗаписан = Истина;
		Результат.ЕстьШтамп = Истина;
		Результат.АдресХранилища = "";
		Результат.ТекстОшибки = "";

		Результат = Акк_ЗакрытьWord(
			Word,
			Документ,
			ДокументШаблон,
			Результат
		);

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецЕсли;

	// ---------------------------------------------------------
	// Открытие шаблона.
	// ---------------------------------------------------------

	Попытка

		ДокументШаблон =
			Word.Documents.Open(
				ПутьШаблона,
				Ложь,
				Истина
			);

	Исключение

		Результат.ТекстОшибки =
			НСтр("en = 'Error opening the stamp template: '; ru = 'Ошибка при открытии шаблона штампа: '; tr = 'Damga şablonu açılırken hata oluştu: '")
			+ ОписаниеОшибки();

		Результат = Акк_ЗакрытьWord(
			Word,
			Документ,
			ДокументШаблон,
			Результат
		);

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецПопытки;

	// ---------------------------------------------------------
	// Замена текста в шаблоне.
	// ---------------------------------------------------------

	Попытка

		Акк_ЗаменитьТекстВШтампе(
			ДокументШаблон,
			"Подразделение",
			Подразделение
		);

		Акк_ЗаменитьТекстВШтампе(
			ДокументШаблон,
			"ФИО_Инициатор",
			ФИО_Инициатор
		);

	Исключение

		Результат.ТекстОшибки =
			НСтр("en = 'Error replacing text in the stamp: '; ru = 'Ошибка при замене текста в штампе: '; tr = 'Damgadaki metin değiştirilirken hata oluştu: '")
			+ ОписаниеОшибки();

		Результат = Акк_ЗакрытьWord(
			Word,
			Документ,
			ДокументШаблон,
			Результат
		);

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецПопытки;

	// ---------------------------------------------------------
	// Поиск штампа в шаблоне.
	// ---------------------------------------------------------

	Попытка

		Штамп =
			Акк_НайтиШтампВШаблоне(
				ДокументШаблон
			);

	Исключение

		Результат.ТекстОшибки =
			НСтр("en = 'Error finding the stamp in the template: '; ru = 'Ошибка при поиске штампа в шаблоне: '; tr = 'Şablonda damga aranırken hata oluştu: '")
			+ ОписаниеОшибки();

		Результат = Акк_ЗакрытьWord(
			Word,
			Документ,
			ДокументШаблон,
			Результат
		);

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецПопытки;

	Если Штамп = Неопределено Тогда

		Результат.ШтампЗаписан = Ложь;
		Результат.ЕстьШтамп = Ложь;
		Результат.АдресХранилища = "";
		Результат.ТекстОшибки =
			НСтр("en = 'The template does not contain an object named '; ru = 'В шаблоне не найден объект с именем '; tr = 'Şablonda şu ada sahip nesne bulunamadı: '")
			+ """ + Акк_ИмяШтампа() + """
			+ ".";
		
		Результат = Акк_ЗакрытьWord(
			Word,
			Документ,
			ДокументШаблон,
			Результат
		);

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецЕсли;

	// ---------------------------------------------------------
	// Подстановка текста уже выполнена выше.
	// Сохраняем заполненный штамп в картинку один раз.
	// ---------------------------------------------------------

	Попытка

		РезультатКартинки =
			Акк_СохранитьШтампКакКартинку(
				Word,
				Штамп
			);

	Исключение

		Результат.ТекстОшибки =
			НСтр("en = 'Error saving the filled stamp as an image: '; ru = 'Ошибка при сохранении заполненного штампа как картинки: '; tr = 'Doldurulmuş damga resim olarak kaydedilirken hata oluştu: '")
			+ ОписаниеОшибки();

		Результат = Акк_ЗакрытьWord(
			Word,
			Документ,
			ДокументШаблон,
			Результат
		);

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецПопытки;

	Если Не РезультатКартинки.Успешно Тогда

		Результат.ТекстОшибки =
			РезультатКартинки.ТекстОшибки;

		Результат = Акк_ЗакрытьWord(
			Word,
			Документ,
			ДокументШаблон,
			Результат
		);

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецЕсли;

	ПутьКартинки = РезультатКартинки.ПутьКартинки;

	// Шаблон больше не нужен — картинка уже сформирована.
	Попытка
		ДокументШаблон.Close(Ложь);
		ДокументШаблон = Неопределено;
	Исключение
		Результат.ТекстОшибки =
			НСтр("en = 'Failed to close the template: '; ru = 'Не удалось закрыть шаблон: '; tr = 'Şablon kapatılamadı: '")
			+ ОписаниеОшибки();

		Результат = Акк_ЗакрытьWord(
			Word,
			Документ,
			ДокументШаблон,
			Результат
		);

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;
	КонецПопытки;

	// ---------------------------------------------------------
	// Вставка картинки штампа на каждую страницу.
	// ---------------------------------------------------------

	РезультатВставки =
		Акк_ВставитьШтампНаКаждуюСтраницу(
			Документ,
			ПутьКартинки,
			РезультатКартинки.Ширина,
			РезультатКартинки.Высота,
			РезультатКартинки.УголПоворота,
			ОтступСлеваМм,
			ОтступСнизуМм
		);

	Если Не РезультатВставки.Успешно Тогда

		Результат.ТекстОшибки =
			РезультатВставки.ТекстОшибки;

		Результат = Акк_ЗакрытьWord(
			Word,
			Документ,
			ДокументШаблон,
			Результат
		);

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецЕсли;

	// ---------------------------------------------------------
	// Сохранение результата.
	// ---------------------------------------------------------

	Попытка

		ФорматDOCX = 16;

		Документ.SaveAs(
			ПутьРезультата,
			ФорматDOCX
		);

	Исключение

		Результат.ТекстОшибки =
			НСтр("en = 'Error saving the modified document: '; ru = 'Ошибка при сохранении измененного документа: '; tr = 'Değiştirilen belge kaydedilirken hata oluştu: '")
			+ ОписаниеОшибки();

		Результат = Акк_ЗакрытьWord(
			Word,
			Документ,
			ДокументШаблон,
			Результат
		);

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецПопытки;

	// ---------------------------------------------------------
	// Закрытие Word.
	// ---------------------------------------------------------

	Результат = Акк_ЗакрытьWord(
		Word,
		Документ,
		ДокументШаблон,
		Результат
	);

	Word = Неопределено;
	Документ = Неопределено;
	ДокументШаблон = Неопределено;

	// ---------------------------------------------------------
	// Чтение результата.
	// ---------------------------------------------------------

	Попытка

		ДвоичныеДанныеРезультата =
			Новый ДвоичныеДанные(
				ПутьРезультата
			);

	Исключение

		Результат.ТекстОшибки =
			НСтр("en = 'Error reading the saved document: '; ru = 'Ошибка при чтении сохраненного документа: '; tr = 'Kaydedilen belge okunurken hata oluştu: '")
			+ ОписаниеОшибки();

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецПопытки;

	// ---------------------------------------------------------
	// Запись результата во временное хранилище.
	// ---------------------------------------------------------

	Попытка

		КлючУникальности = Новый УникальныйИдентификатор;
		АдресХранилища = ПоместитьВоВременноеХранилище(
			ДвоичныеДанныеРезультата,
			КлючУникальности);

	Исключение

		Результат.ТекстОшибки =
			НСтр("en = 'Error writing the result to temporary storage: '; ru = 'Ошибка при записи результата во временное хранилище: '; tr = 'Sonuç geçici depolamaya yazılırken hata oluştu: '")
			+ ОписаниеОшибки();

		Результат = Акк_УдалитьВременныеФайлы(
			ПутьШаблона,
			ПутьФайла,
			ПутьРезультата,
			ПутьКартинки,
			Результат
		);

		Возврат Результат;

	КонецПопытки;

	// ---------------------------------------------------------
	// Успешное завершение.
	// ---------------------------------------------------------

	Результат.ШтампЗаписан = Истина;
	Результат.ЕстьШтамп = Ложь;
	Результат.АдресХранилища = АдресХранилища;
	Результат.ТекстОшибки = "";

	Результат = Акк_УдалитьВременныеФайлы(
		ПутьШаблона,
		ПутьФайла,
		ПутьРезультата,
		ПутьКартинки,
		Результат
	);

	Возврат Результат;

КонецФункции
