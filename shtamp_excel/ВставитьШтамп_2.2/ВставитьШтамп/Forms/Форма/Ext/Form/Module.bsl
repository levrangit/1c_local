&НаКлиенте
Процедура АккВыполнитьТест(Команда)

    ТекстРезультата = "";

    Если ПустаяСтрока(ЭтотОбъект.АдресШтампа) Тогда

        ТекстРезультата =
            "Не выбран файл штампа.";

        Возврат;

    КонецЕсли;

    Если ПустаяСтрока(ЭтотОбъект.АдресДокумента) Тогда

        ТекстРезультата =
            "Не выбран файл документа.";

        Возврат;

    КонецЕсли;

    Если ПустаяСтрока(ЭтотОбъект.Подразделение) Тогда

        ТекстРезультата =
            "Не заполнено поле Подразделение.";

        Возврат;

    КонецЕсли;

    Если ПустаяСтрока(ЭтотОбъект.ФИО_Инициатор) Тогда

        ТекстРезультата =
            "Не заполнено поле ФИО инициатора.";

        Возврат;

    КонецЕсли;
	
	ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект,УникальныйИдентификатор);
	ФормаДлительнойОперации.ТекстСообщения = "Запись штампа в документ...";
	
    Результат =
        Акк_ВыполнитьТестНаКлиенте();

	ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);		
		
    Если Результат = Неопределено Тогда

        ТекстРезультата =
            "Серверная процедура не вернула результат.";

        Возврат;

    КонецЕсли;

    Если Результат.Свойство("ТекстОшибки")
        И Не ПустаяСтрока(Результат.ТекстОшибки) Тогда

        ТекстРезультата =
            Результат.ТекстОшибки;

    ИначеЕсли Результат.Свойство("АдресХранилища")
        И Не ПустаяСтрока(Результат.АдресХранилища) Тогда

        ТекстРезультата =
            "Тест успешно выполнен."
            + Символы.ПС
            + "Адрес результата: "
            + Результат.АдресХранилища;

        Акк_СохранитьРезультатНаКлиенте(
            Результат.АдресХранилища);

    Иначе

        ТекстРезультата =
            "Тест завершен.";

    КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура Акк_СохранитьРезультатНаКлиенте(АдресХранилища)

    Если ПустаяСтрока(АдресХранилища) Тогда
        Возврат;
    КонецЕсли;

	
	
    ИмяФайлаРезультата =
        Акк_ИмяРезультирующегоФайла(ЭтотОбъект.ИмяДокумента);

    ПараметрыДиалога =
        Новый ПараметрыДиалогаПолученияФайлов;

    ПараметрыДиалога.Заголовок =
        "Сохранение документа со штампом";

    НачатьПолучениеФайлаССервера(
        АдресХранилища,
        ИмяФайлаРезультата,
        ПараметрыДиалога);

КонецПроцедуры


&НаКлиенте
Функция Акк_ИмяРезультирующегоФайла(ИмяИсходногоФайла)

    Если ПустаяСтрока(ИмяИсходногоФайла) Тогда
        Возврат "ДокументШтамп.docx";
    КонецЕсли;

    ПозицияРасширения =
        СтрНайти(
            НРег(ИмяИсходногоФайла),
            ".docx");

    Если ПозицияРасширения > 0 Тогда

        Возврат
            Лев(
                ИмяИсходногоФайла,
                ПозицияРасширения - 1)
            + "Штамп.docx";

    КонецЕсли;

    Возврат ИмяИсходногоФайла + "Штамп.docx";

КонецФункции


&НаКлиенте
Функция Акк_ВыполнитьТестНаКлиенте()

    Если Не ЭтоАдресВременногоХранилища(ЭтотОбъект.АдресШтампа) Тогда

        Возврат Акк_ОшибкаТеста(
            "Адрес штампа не является адресом временного хранилища.");

    КонецЕсли;

    Если Не ЭтоАдресВременногоХранилища(ЭтотОбъект.АдресДокумента) Тогда

        Возврат Акк_ОшибкаТеста(
            "Адрес документа не является адресом временного хранилища.");

    КонецЕсли;

    ДвоичныеДанныеШтампа =
        ПолучитьИзВременногоХранилища(
            ЭтотОбъект.АдресШтампа);

    ДвоичныеДанныеДокумента =
        ПолучитьИзВременногоХранилища(
            ЭтотОбъект.АдресДокумента);

    Если ТипЗнч(ДвоичныеДанныеШтампа)
        <> Тип("ДвоичныеДанные") Тогда

        Возврат Акк_ОшибкаТеста(
            "Во временном хранилище штампа находятся не двоичные данные.");

    КонецЕсли;

    Если ТипЗнч(ДвоичныеДанныеДокумента)
        <> Тип("ДвоичныеДанные") Тогда

        Возврат Акк_ОшибкаТеста(
            "Во временном хранилище документа находятся не двоичные данные.");

    КонецЕсли;

    Возврат Акк_ВставитьШтампВФайл(
        ДвоичныеДанныеШтампа,
        ДвоичныеДанныеДокумента,
        ЭтотОбъект.Подразделение,
        ЭтотОбъект.ФИО_Инициатор,
        ЭтотОбъект.ОтступСлеваМм,
        ЭтотОбъект.ОтступСнизуМм);

КонецФункции

&НаКлиенте
Функция Акк_ОшибкаТеста(ТекстОшибки)

    Результат = Новый Структура;

    Результат.Вставить(
        "ШтампЗаписан",
        Ложь);

    Результат.Вставить(
        "ЕстьШтамп",
        Ложь);

    Результат.Вставить(
        "АдресХранилища",
        "");

    Результат.Вставить(
        "ТекстОшибки",
        ТекстОшибки);

    Возврат Результат;

КонецФункции

