&НаКлиенте
Функция Акк_НайтиШтампВДокументе(Документ)

	ИмяШтампа = Акк_ИмяШтампа();

	Для Номер = 1 По Документ.Shapes.Count Цикл

		Shape = Документ.Shapes.Item(Номер);

		Если Shape.Name = ИмяШтампа Тогда
			Возврат Shape;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции


