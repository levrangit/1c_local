
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    РеквизитыФормы = Новый Массив;

    РеквизитыФормы.Добавить(
        Новый РеквизитФормы(
            "АдресШтампа",
            Новый ОписаниеТипов("Строка"),
            ,
            "Адрес штампа"));

    РеквизитыФормы.Добавить(
        Новый РеквизитФормы(
            "ИмяШтампа",
            Новый ОписаниеТипов("Строка"),
            ,
            "Файл штампа"));

    РеквизитыФормы.Добавить(
        Новый РеквизитФормы(
            "АдресДокумента",
            Новый ОписаниеТипов("Строка"),
            ,
            "Адрес документа"));

    РеквизитыФормы.Добавить(
        Новый РеквизитФормы(
            "ИмяДокумента",
            Новый ОписаниеТипов("Строка"),
            ,
            "Файл документа"));

    РеквизитыФормы.Добавить(
        Новый РеквизитФормы(
            "Подразделение",
            Новый ОписаниеТипов("Строка"),
            ,
            "Подразделение"));

    РеквизитыФормы.Добавить(
        Новый РеквизитФормы(
            "ФИО_Инициатор",
            Новый ОписаниеТипов("Строка"),
            ,
            "ФИО инициатора"));

    РеквизитыФормы.Добавить(
        Новый РеквизитФормы(
            "ОтступСлеваМм",
            Новый ОписаниеТипов("Число"),
            ,
            "Отступ слева, мм"));

    РеквизитыФормы.Добавить(
        Новый РеквизитФормы(
            "ОтступСнизуМм",
            Новый ОписаниеТипов("Число"),
            ,
            "Отступ снизу, мм"));

    РеквизитыФормы.Добавить(
        Новый РеквизитФормы(
            "ТекстРезультата",
            Новый ОписаниеТипов("Строка"),
            ,
            "Результат"));

    ИзменитьРеквизиты(РеквизитыФормы);

    ЭтотОбъект.ОтступСлеваМм = 20;
    ЭтотОбъект.ОтступСнизуМм = 10;

    Акк_СоздатьИнтерфейсНаСервере();

КонецПроцедуры


