&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    РеквизитыФормы = Новый Массив;
    РеквизитыФормы.Добавить(Новый РеквизитФормы("АдресШтампа", Новый ОписаниеТипов("Строка"), , "Файл шаблона Excel"));
    РеквизитыФормы.Добавить(Новый РеквизитФормы("ИмяШтампа", Новый ОписаниеТипов("Строка"), , "Файл шаблона"));
    РеквизитыФормы.Добавить(Новый РеквизитФормы("АдресДокумента", Новый ОписаниеТипов("Строка"), , "Файл книги Excel"));
    РеквизитыФормы.Добавить(Новый РеквизитФормы("ИмяДокумента", Новый ОписаниеТипов("Строка"), , "Файл документа"));
    РеквизитыФормы.Добавить(Новый РеквизитФормы("Подразделение", Новый ОписаниеТипов("Строка"), , "Подразделение"));
    РеквизитыФормы.Добавить(Новый РеквизитФормы("ФИО_Инициатор", Новый ОписаниеТипов("Строка"), , "ФИО инициатора"));
    РеквизитыФормы.Добавить(Новый РеквизитФормы("ОтступСлеваМм", Новый ОписаниеТипов("Число"), , "Отступ слева, мм"));
    РеквизитыФормы.Добавить(Новый РеквизитФормы("ОтступСнизуМм", Новый ОписаниеТипов("Число"), , "Отступ снизу, мм"));
    РеквизитыФормы.Добавить(Новый РеквизитФормы("ТекстРезультата", Новый ОписаниеТипов("Строка"), , "Результат"));
    ИзменитьРеквизиты(РеквизитыФормы);

    ЭтотОбъект.ОтступСлеваМм = 20;
    ЭтотОбъект.ОтступСнизуМм = 10;
    Акк_СоздатьИнтерфейсНаСервере();

КонецПроцедуры

&НаСервере
Процедура Акк_СоздатьИнтерфейсНаСервере()
    Для Каждого Имя Из Новый Массив("ИмяШтампа", "ИмяДокумента", "Подразделение", "ФИО_Инициатор", "ОтступСлеваМм", "ОтступСнизуМм", "ТекстРезультата") Цикл
        Поле = Элементы.Добавить("Поле" + Имя, Тип("ПолеФормы"));
        Поле.Вид = ВидПоляФормы.ПолеВвода;
        Поле.ПутьКДанным = Имя;
    КонецЦикла;

    Для Каждого Пара Из Новый Массив(
        Новый Структура("Имя,Заголовок", "АккВыбратьШтамп", "Выбрать шаблон Excel"),
        Новый Структура("Имя,Заголовок", "АккВыбратьДокумент", "Выбрать книгу Excel"),
        Новый Структура("Имя,Заголовок", "АккВыполнитьТест", "Вставить штамп")) Цикл
        Команда = Команды.Добавить(Пара.Имя);
        Команда.Действие = Пара.Имя;
        Команда.Заголовок = Пара.Заголовок;
        Кнопка = Элементы.Добавить("Кнопка" + Пара.Имя, Тип("КнопкаФормы"));
        Кнопка.ИмяКоманды = Пара.Имя;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура АккВыбратьШтамп(Команда)
    Акк_ВыбратьExcelФайл("АккПослеВыбораШтампа");
КонецПроцедуры

&НаКлиенте
Процедура АккВыбратьДокумент(Команда)
    Акк_ВыбратьExcelФайл("АккПослеВыбораДокумента");
КонецПроцедуры

&НаКлиенте
Процедура Акк_ВыбратьExcelФайл(ИмяОбработчика)
    ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
    ПараметрыДиалога.МножественныйВыбор = Ложь;
    ПараметрыДиалога.Фильтр = "Книга Excel (*.xlsx)|*.xlsx|";
    Оповещение = Новый ОписаниеОповещения(ИмяОбработчика, ЭтаФорма);
    НачатьПомещениеФайлаНаСервер(Оповещение, , , , ПараметрыДиалога, ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура АккПослеВыбораШтампа(ОписаниеФайла, ДополнительныеПараметры) Экспорт
    Если ОписаниеФайла = Неопределено Или ОписаниеФайла = ПомещениеФайлаОтменено Тогда Возврат; КонецЕсли;
    ЭтотОбъект.АдресШтампа = ОписаниеФайла.Адрес;
    ЭтотОбъект.ИмяШтампа = ОписаниеФайла.СсылкаНаФайл.Имя;
КонецПроцедуры

&НаКлиенте
Процедура АккПослеВыбораДокумента(ОписаниеФайла, ДополнительныеПараметры) Экспорт
    Если ОписаниеФайла = Неопределено Или ОписаниеФайла = ПомещениеФайлаОтменено Тогда Возврат; КонецЕсли;
    ЭтотОбъект.АдресДокумента = ОписаниеФайла.Адрес;
    ЭтотОбъект.ИмяДокумента = ОписаниеФайла.СсылкаНаФайл.Имя;
КонецПроцедуры

&НаКлиенте
Процедура АккВыполнитьТест(Команда)
    ЭтотОбъект.ТекстРезультата = "";
    Если ПустаяСтрока(ЭтотОбъект.АдресШтампа) Тогда ЭтотОбъект.ТекстРезультата = "Не выбран шаблон штампа."; Возврат; КонецЕсли;
    Если ПустаяСтрока(ЭтотОбъект.АдресДокумента) Тогда ЭтотОбъект.ТекстРезультата = "Не выбрана книга Excel."; Возврат; КонецЕсли;
    Если ПустаяСтрока(ЭтотОбъект.Подразделение) Тогда ЭтотОбъект.ТекстРезультата = "Не заполнено подразделение."; Возврат; КонецЕсли;
    Если ПустаяСтрока(ЭтотОбъект.ФИО_Инициатор) Тогда ЭтотОбъект.ТекстРезультата = "Не заполнено ФИО инициатора."; Возврат; КонецЕсли;

    ДвоичныеДанныеШтампа = ПолучитьИзВременногоХранилища(ЭтотОбъект.АдресШтампа);
    ДвоичныеДанныеДокумента = ПолучитьИзВременногоХранилища(ЭтотОбъект.АдресДокумента);
    Если ТипЗнч(ДвоичныеДанныеШтампа) <> Тип("ДвоичныеДанные") Или ТипЗнч(ДвоичныеДанныеДокумента) <> Тип("ДвоичныеДанные") Тогда
        ЭтотОбъект.ТекстРезультата = "Не удалось прочитать выбранные Excel-файлы из временного хранилища.";
        Возврат;
    КонецЕсли;

    Результат = Акк_ВставитьШтампВКнигу(
        ДвоичныеДанныеШтампа, ДвоичныеДанныеДокумента,
        ЭтотОбъект.Подразделение, ЭтотОбъект.ФИО_Инициатор,
        ЭтотОбъект.ОтступСлеваМм, ЭтотОбъект.ОтступСнизуМм);

    Если Не ПустаяСтрока(Результат.ТекстОшибки) Тогда
        ЭтотОбъект.ТекстРезультата = Результат.ТекстОшибки;
        Возврат;
    КонецЕсли;

    ИмяРезультата = Акк_ИмяРезультирующегоФайла(ЭтотОбъект.ИмяДокумента);
    ПараметрыПолучения = Новый ПараметрыДиалогаПолученияФайлов;
    ПараметрыПолучения.Заголовок = "Сохранение книги Excel со штампом";
    НачатьПолучениеФайлаССервера(Результат.АдресХранилища, ИмяРезультата, ПараметрыПолучения);
    ЭтотОбъект.ТекстРезультата = "Штамп добавлен. Подготовлен файл: " + ИмяРезультата;
КонецПроцедуры

&НаКлиенте
Функция Акк_ИмяРезультирующегоФайла(ИмяИсходногоФайла)
    Позиция = СтрНайти(НРег(ИмяИсходногоФайла), ".xlsx");
    Если Позиция > 0 Тогда Возврат Лев(ИмяИсходногоФайла, Позиция - 1) + "Штамп.xlsx"; КонецЕсли;
    Возврат ИмяИсходногоФайла + "Штамп.xlsx";
КонецФункции

&НаКлиенте
Функция Акк_ВставитьШтампВКнигу(ДвоичныеДанныеШтампа, ДвоичныеДанныеКниги, Подразделение, ФИОИнициатор, ОтступСлеваМм, ОтступСнизуМм)
    Результат = Новый Структура("АдресХранилища,ТекстОшибки", "", "");
    ПутьШаблона = ПолучитьИмяВременногоФайла("xlsx");
    ПутьКниги = ПолучитьИмяВременногоФайла("xlsx");
    ПутьРезультата = ПолучитьИмяВременногоФайла("xlsx");
    Excel = Неопределено;
    КнигаШаблона = Неопределено;
    Книга = Неопределено;

    Попытка
        ДвоичныеДанныеШтампа.Записать(ПутьШаблона);
        ДвоичныеДанныеКниги.Записать(ПутьКниги);
        Excel = Новый COMОбъект("Excel.Application");
        Excel.Visible = Ложь;
        Excel.DisplayAlerts = Ложь;
        КнигаШаблона = Excel.Workbooks.Open(ПутьШаблона, 0, Истина);
        Книга = Excel.Workbooks.Open(ПутьКниги, 0, Ложь);

        Штамп = Неопределено;
        Для Каждого ЛистШаблона Из КнигаШаблона.Worksheets Цикл
            Попытка
                Штамп = ЛистШаблона.Shapes("Акк_Штамп");
                Прервать;
            Исключение
                Штамп = Неопределено;
            КонецПопытки;
        КонецЦикла;
        Если Штамп = Неопределено Тогда
            ВызватьИсключение "В шаблоне Excel не найдена фигура с именем ""Акк_Штамп"".";
        КонецЕсли;

        Для Каждого ЛистШаблона Из КнигаШаблона.Worksheets Цикл
            Для Каждого Фигура Из ЛистШаблона.Shapes Цикл
                Попытка
                    ТекстФигуры = Фигура.TextFrame2.TextRange.Text;
                    ТекстФигуры = СтрЗаменить(ТекстФигуры, "Подразделение", Подразделение);
                    ТекстФигуры = СтрЗаменить(ТекстФигуры, "ФИО_Инициатор", ФИОИнициатор);
                    Фигура.TextFrame2.TextRange.Text = ТекстФигуры;
                Исключение
                КонецПопытки;
            КонецЦикла;
        КонецЦикла;

        Для Каждого Лист Из Книга.Worksheets Цикл
            ИспользуемыйДиапазон = Лист.UsedRange;
            Если ИспользуемыйДиапазон.Rows.Count = 1 И ИспользуемыйДиапазон.Columns.Count = 1 И ПустаяСтрока(Строка(ИспользуемыйДиапазон.Cells(1, 1).Text)) Тогда
                Продолжить;
            КонецЕсли;

            ЛистШтампа = Неопределено;
            Для Каждого ЛистШаблона Из КнигаШаблона.Worksheets Цикл
                Попытка
                    ЛистШтампа = ЛистШаблона;
                    Штамп = ЛистШаблона.Shapes("Акк_Штамп");
                    Прервать;
                Исключение
                    ЛистШтампа = Неопределено;
                КонецПопытки;
            КонецЦикла;
            Если ЛистШтампа = Неопределено Тогда
                ВызватьИсключение "Не удалось повторно получить фигуру штампа.";
            КонецЕсли;

            Штамп.Copy();
            Лист.Paste();
            НоваяФигура = Лист.Shapes(Лист.Shapes.Count);
            НоваяФигура.Name = "Акк_Штамп_Авто_" + Строка(Лист.Index);
            НоваяФигура.Placement = 3;
            НоваяФигура.Left = Лист.Cells(ИспользуемыйДиапазон.Row + ИспользуемыйДиапазон.Rows.Count - 1, ИспользуемыйДиапазон.Column).Left + ОтступСлеваМм * 2.83464567;
            НоваяФигура.Top = Лист.Cells(ИспользуемыйДиапазон.Row + ИспользуемыйДиапазон.Rows.Count - 1, ИспользуемыйДиапазон.Column).Top + ИспользуемыйДиапазон.Rows(ИспользуемыйДиапазон.Rows.Count).Height - НоваяФигура.Height - ОтступСнизуМм * 2.83464567;
        КонецЦикла;

        Книга.SaveAs(ПутьРезультата, 51);
        Книга.Close(Истина);
        КнигаШаблона.Close(Ложь);
        Excel.Quit();
        Excel = Неопределено;

        ДанныеРезультата = Новый ДвоичныеДанные(ПутьРезультата);
        Адрес = ПоместитьВоВременноеХранилище(ДанныеРезультата, Новый УникальныйИдентификатор);
        Результат.АдресХранилища = Адрес;
    Исключение
        Результат.ТекстОшибки = "Ошибка при обработке Excel: " + ОписаниеОшибки();
        Попытка
            Если Книга <> Неопределено Тогда Книга.Close(Ложь); КонецЕсли;
        Исключение
        КонецПопытки;
        Попытка
            Если КнигаШаблона <> Неопределено Тогда КнигаШаблона.Close(Ложь); КонецЕсли;
        Исключение
        КонецПопытки;
        Попытка
            Если Excel <> Неопределено Тогда Excel.Quit(); КонецЕсли;
        Исключение
        КонецПопытки;
    КонецПопытки;

    Попытка УдалитьФайлы(ПутьШаблона); Исключение КонецПопытки;
    Попытка УдалитьФайлы(ПутьКниги); Исключение КонецПопытки;
    Попытка УдалитьФайлы(ПутьРезультата); Исключение КонецПопытки;
    Возврат Результат;
КонецФункции
